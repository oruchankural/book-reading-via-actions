PORT=3001

# The deployed frontend's exact origin (scheme + host, no trailing slash).
# Required so the browser will accept the API's cookies from a different
# domain than the site itself. Example: https://folio.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Google Cloud OAuth 2.0 Web Client ID (same value the client's
# VITE_GOOGLE_CLIENT_ID uses — they're two separate .env files now that the
# API is its own project, but it's the same Google Cloud client).
GOOGLE_CLIENT_ID=

# Random, long, secret string used to sign session cookies. Generate one
# with: openssl rand -hex 32
JWT_SECRET=change-me
